{
  "name": "Book API Dev Container",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "runServices": ["postgres"],
  "workspaceFolder": "/workspaces/book-api",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "containerEnv": {
    "GRADLE_USER_HOME": "/workspaces/book-api/.gradle"
  },
  "forwardPorts": [5432, 8080],
  "portsAttributes": {
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "Spring Boot App",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-spring-boot", "bradymholt.pgformatter"],
      "settings": {
        "java.import.gradle.wrapper.enabled": true
      }
    }
  }
}
